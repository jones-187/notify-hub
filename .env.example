# 复制本文件为 .env，再填上自己生成的真令牌。.env 不进 git，也不进镜像。

# 令牌（必填）。整个服务共用一个 bearer 令牌。
# 生成方式（32 字节，十六进制，约 64 个字符）：
#   Linux / macOS：openssl rand -hex 32
#   Windows     ：python -c "import secrets; print(secrets.token_hex(32))"
# 令牌只从环境变量 NOTIFY_TOKEN 传给容器，不写进镜像、不入库、不进 git。
NOTIFY_TOKEN=

# 可选：宿主机映射端口。默认 8080（公网/MCP）与 8081（内网接口）。
# NAS 上这两个端口若已被别的服务占用，在这里改成空闲端口，例如 18080 / 18081。
# 容器内部永远是 8080/8081，改这里不影响服务代码；配内网穿透时映射 MCP_HOST_PORT。
#MCP_HOST_PORT=18080
#INTERNAL_HOST_PORT=18081
